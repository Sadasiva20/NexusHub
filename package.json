{
  "name": "nexushub",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "sb:login": "storyblok login",
    "sb:pull": "storyblok pull-components",
    "sb:push": "storyblok push-components",
    "sb:migrate": "storyblok generate-migration",
    "sb:validate": "storyblok validate",
    "sync-schemas": "npm run sb:pull && npm run sb:validate",
    "deploy-schemas": "npm run sb:validate && npm run sb:push",
    "auto-sync": "npm run sync-schemas && npm run deploy-schemas",
    "test": "npm run lint && npm run type-check",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.76",
    "@next/env": "^16.3.5",
    "@storyblok/react": "^7.3.1",
    "@supabase/supabase-js": "^2.116.0",
    "ai": "^7.0.107",
    "next": "16.3.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "storyblok-js-client": "^7.7.6",
    "three": "^0.186.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "^0.186.0",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
